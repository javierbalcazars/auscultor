{
  "name": "whatsapp-bot",
  "version": "1.5.3",
  "type": "module",
  "description": "Bot de WhatsApp que responde preguntas de clientes usando archivos Markdown y un LLM",
  "license": "AGPL-3.0-or-later",
  "main": "src/index.js",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "check:public": "node scripts/validate-public-project.js",
    "evals": "node scripts/run-evals.js",
    "evals:live": "node scripts/run-evals.js --live",
    "backup": "node scripts/manage-backups.js",
    "metrics": "node scripts/show-metrics.js",
    "diagnostics": "node scripts/diagnostics.js",
    "chats": "node scripts/manage-chats.js",
    "admin": "node src/admin/server.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0"
  }
}
