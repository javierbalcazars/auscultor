# ES: Ruta a la carpeta que contiene las FAQs y los chats.
# EN: Path to the folder containing FAQs and chats.
VAULT_PATH=./Vault

# ES: Nombre comercial que aparecerá en los mensajes y registros.
# EN: Business name displayed in messages and logs.
BUSINESS_NAME=Nombre de tu negocio

# ES: Clave API de OpenAI y modelo utilizado para responder.
# EN: OpenAI API key and model used to generate replies.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ES: Carpeta dentro del Vault donde se guarda una nota por cada chat.
# EN: Folder inside the Vault where one note is stored for each chat.
CONVERSATIONS_FOLDER=Chats

# ES: Horas sin mensajes antes de iniciar un contexto nuevo.
# EN: Hours without messages before starting a new context.
CONVERSATION_EXPIRY_HOURS=24

# ES: Días antes de que mantenimiento considere eliminable un chat.
# EN: Days before maintenance considers a chat eligible for deletion.
CONVERSATION_RETENTION_DAYS=180

# ES: Límites de historial, entrada y frecuencia.
# EN: History, input, batch, and request limits.
MAX_HISTORY_MESSAGES=10
MAX_STORED_MESSAGES=10
MAX_INPUT_CHARS=6000
MAX_BATCH_MESSAGES=20
MAX_REQUESTS_PER_HOUR=30

# ES: Espera para agrupar mensajes consecutivos (4000 ms = 4 segundos).
# EN: Wait used to group consecutive messages (4000 ms = 4 seconds).
RESPONSE_DELAY_MS=4000

# ES: Diagnóstico inicial de sesiones cifradas (3000 ms = 3 segundos).
# EN: Initial encrypted-session diagnostics (3000 ms = 3 seconds).
SIGNAL_STARTUP_VALIDATION_MS=3000

# ES: Reenvía al encargado audios de 10 segundos o más.
# EN: Forwards audio messages lasting 10 seconds or more to a manager.
AUDIO_FORWARD_MIN_SECONDS=10

# ES: Tiempo máximo de espera y límite de tokens de salida de OpenAI.
# EN: OpenAI timeout and output token limit.
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=600

# ES: Uno o más encargados con código de país, separados por comas.
# EN: One or more manager numbers with country code, separated by commas.
HUMAN_SUPPORT_NUMBERS=+569XXXXXXXX
HUMAN_ALERT_COOLDOWN_MINUTES=60
HUMAN_TAKEOVER_HOURS=2

# ES: Números ignorados, separados por comas. Puede incluir al encargado.
# EN: Ignored numbers, separated by commas. The manager number may be included.
IGNORE_NUMBERS=
