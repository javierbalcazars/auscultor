# Ruta a la carpeta que contiene las FAQs y los chats
VAULT_PATH=./Vault

# Nombre comercial que aparecerá en mensajes y logs
BUSINESS_NAME=Nombre de tu glamping

# API key de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Carpeta dentro del Vault donde se guarda una nota por cada chat
CONVERSATIONS_FOLDER=Chats

# Horas sin mensajes antes de iniciar un contexto nuevo
CONVERSATION_EXPIRY_HOURS=24

# Días antes de que la herramienta de mantenimiento considere eliminable un chat
CONVERSATION_RETENTION_DAYS=180

# Límites de historial, entrada y frecuencia
MAX_HISTORY_MESSAGES=10
MAX_STORED_MESSAGES=10
MAX_INPUT_CHARS=6000
MAX_BATCH_MESSAGES=20
MAX_REQUESTS_PER_HOUR=30

# Espera para agrupar mensajes consecutivos (4000 ms = 4 segundos)
RESPONSE_DELAY_MS=4000

# Diagnóstico inicial de sesiones cifradas (3000 ms = 3 segundos)
SIGNAL_STARTUP_VALIDATION_MS=3000

# Reenvía al encargado audios de 10 segundos o más
AUDIO_FORWARD_MIN_SECONDS=10

# Configuración de OpenAI
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=600

# Número del encargado con código de país y solo dígitos
HUMAN_SUPPORT_NUMBER=569XXXXXXXX
HUMAN_ALERT_COOLDOWN_MINUTES=60
HUMAN_TAKEOVER_HOURS=2

# Números ignorados, separados por coma. Puede incluir el número del encargado.
IGNORE_NUMBERS=
